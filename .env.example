NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the local auth seed script and the Midtrans payment
# webhook/payment-intent flow (src/lib/supabase/admin.ts). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (class enrollment payments). Sandbox keys from the Midtrans dashboard.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" only once switching to a live production Midtrans account.
MIDTRANS_IS_PRODUCTION=false

# Optional credentials for integration and end-to-end tests.
SUPABASE_TEST_PARTICIPANT_EMAIL=peserta@scopusready.test
SUPABASE_TEST_PARTICIPANT_PASSWORD=Participant123!
SUPABASE_TEST_TRAINER_EMAIL=trainer@scopusready.test
SUPABASE_TEST_TRAINER_PASSWORD=Trainer123!
SUPABASE_TEST_ADMIN_EMAIL=admin@scopusready.test
SUPABASE_TEST_ADMIN_PASSWORD=Admin123!
E2E_PARTICIPANT_EMAIL=peserta@scopusready.test
E2E_PARTICIPANT_PASSWORD=Participant123!
